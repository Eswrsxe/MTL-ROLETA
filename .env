# O MESMO banco usado pelo bot (é assim que os dois compartilham saldo de
# moedas/giros e a tabela de prêmios). O site NUNCA roda migrations — só lê e
# escreve nas tabelas que o bot já criou.
DATABASE_URL=

# Aplicação do Discord (Discord Developer Portal > sua aplicação > OAuth2).
# Pode ser a MESMA aplicação do bot — só precisa habilitar o redirect abaixo.
DISCORD_CLIENT_ID=1544881889234391071
DISCORD_CLIENT_SECRET=

# Origem pública do site depois do deploy na Vercel, ex.: https://mtl-roleta.vercel.app
# Cadastre exatamente "<SITE_ORIGIN>/api/auth/callback" como Redirect URI no
# Discord Developer Portal (OAuth2 > Redirects).
SITE_ORIGIN=https://mtl-roleta.vercel.app

# Segredo usado para assinar o cookie de sessão (HMAC). Gere um valor
# aleatório forte, ex.: `openssl rand -hex 32`, e nunca reutilize entre
# ambientes.
SESSION_SECRET=